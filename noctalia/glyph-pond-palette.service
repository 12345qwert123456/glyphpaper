# Пользовательский сервис systemd для сервера палитры.
#   cp noctalia/glyph-pond-palette.service ~/.config/systemd/user/
#   (поправьте путь в ExecStart)
#   systemctl --user enable --now glyph-pond-palette.service
[Unit]
Description=Glyph Pond palette server (127.0.0.1 only)

[Service]
ExecStart=/usr/bin/env python3 %h/src/glyph-pond/tools/palette-server.py --port 8765
Restart=on-failure

[Install]
WantedBy=default.target
